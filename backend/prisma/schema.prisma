generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. AUTH & ROLES
// ==========================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String?
  roleId       String
  role         Role          @relation(fields: [roleId], references: [id])
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]

  @@index([roleId])
  @@map("users")
}

// ==========================================
// 2. CUSTOMERS & INQUIRIES
// ==========================================

model Customer {
  id            String         @id @default(uuid())
  name          String
  email         String
  phone         String
  company       String?
  address       String?
  city          String?        @default("Dubai")
  notes         String?        @db.Text
  zohoContactId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inquiries     Inquiry[]
  bookings      Booking[]
  invitations   Invitation[]
  aiGenerations AiGeneration[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

enum InquiryStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  UNDER_REVIEW
  CONFIRMED
  CANCELLED
}

model Inquiry {
  id                String             @id @default(uuid())
  referenceNo       String             @unique
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  eventType         String?
  eventStyle        String?            @default("Luxury")
  eventDate         DateTime?
  eventLocation     String?            @default("Dubai")
  guestsCount       Int?               @default(200)
  budgetRange       String?
  status            InquiryStatus      @default(NEW)
  priority          String?            @default("MEDIUM")
  zohoLeadId        String?
  assignedTo        String?
  notes             String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  requirements      Requirement?
  bookings          Booking[]
  communicationLogs CommunicationLog[]

  @@index([customerId])
  @@index([status])
  @@index([referenceNo])
  @@map("inquiries")
}

model Requirement {
  id                   String   @id @default(uuid())
  inquiryId            String   @unique
  inquiry              Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  serviceRequirements  Json?
  inventoryPreferences Json?
  preferredTheme       String?
  specialInstructions  String?  @db.Text
  referenceAttachments Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("requirements")
}

// ==========================================
// 3. SERVICES & PORTFOLIO
// ==========================================

model Service {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String   @db.Text
  shortDesc     String?
  priceStarting Float?   @default(0)
  pricingUnit   String?  @default("event")
  images        Json?
  videos        Json?
  features      Json?
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

model PortfolioProject {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  clientName        String?
  eventType         String
  eventDate         DateTime?
  location          String?  @default("Dubai, UAE")
  description       String   @db.Text
  coverImage        String
  images            Json?
  videos            Json?
  aiGeneratedImages Json?
  finalVideos       Json?
  category          String?  @default("Wedding")
  tags              Json?
  isFeatured        Boolean  @default(false)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("portfolio_projects")
}

// ==========================================
// 4. DYNAMIC INVENTORY & AVAILABILITY
// ==========================================

model InventoryCategory {
  id            String                 @id @default(uuid())
  name          String                 @unique
  slug          String                 @unique
  description   String?                @db.Text
  icon          String?
  image         String?
  sortOrder     Int                    @default(0)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  subcategories InventorySubcategory[]
  items         InventoryItem[]

  @@map("inventory_categories")
}

model InventorySubcategory {
  id          String            @id @default(uuid())
  categoryId  String
  category    InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       InventoryItem[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("inventory_subcategories")
}

enum InventoryStatus {
  AVAILABLE
  LIMITED
  RESERVED
  MAINTENANCE
  OUT_OF_STOCK
}

model InventoryItem {
  id                String                  @id @default(uuid())
  sku               String                  @unique
  name              String
  slug              String                  @unique
  categoryId        String
  category          InventoryCategory       @relation(fields: [categoryId], references: [id])
  subcategoryId     String?
  subcategory       InventorySubcategory?   @relation(fields: [subcategoryId], references: [id])
  theme             String?
  description       String?                 @db.Text
  specifications    Json?
  price             Float                   @default(0)
  unit              String                  @default("each")
  tradePrice        Float?                  @default(0)
  tradeCategory     String?                 @default("Décor")
  totalQuantity     Int                     @default(1)
  availableQuantity Int                     @default(1)
  minOrderQty       Int                     @default(1)
  maxOrderQty       Int                     @default(100)
  status            InventoryStatus         @default(AVAILABLE)
  isAvailable       Boolean                 @default(true)
  isEnabled         Boolean                 @default(true)
  isFeatured        Boolean                 @default(false)
  tags              Json?
  coverImage        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  media             InventoryMedia[]
  availabilities    InventoryAvailability[]
  bookingItems      BookingItem[]
  aiGenerationItems AiGenerationItem[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([theme])
  @@map("inventory_items")
}

enum MediaType {
  IMAGE
  VIDEO
}

model InventoryMedia {
  id        String        @id @default(uuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mediaType MediaType     @default(IMAGE)
  url       String
  altText   String?
  isPrimary Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@map("inventory_media")
}

model InventoryAvailability {
  id               String          @id @default(uuid())
  itemId           String
  item             InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  date             DateTime        @db.Date
  status           InventoryStatus @default(AVAILABLE)
  reservedQuantity Int             @default(0)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([itemId, date])
  @@index([itemId])
  @@index([date])
  @@map("inventory_availability")
}

// ==========================================
// 5. BOOKINGS & RESERVATIONS
// ==========================================

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  inquiryId        String?
  inquiry          Inquiry?      @relation(fields: [inquiryId], references: [id])
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  eventName        String
  startDate        DateTime
  endDate          DateTime
  venue            String?
  totalAmount      Float         @default(0)
  discountAmount   Float         @default(0)
  taxAmount        Float         @default(0)
  finalAmount      Float         @default(0)
  status           BookingStatus @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            BookingItem[]

  @@index([customerId])
  @@index([startDate, endDate])
  @@index([status])
  @@map("bookings")
}

model BookingItem {
  id         String        @id @default(uuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  quantity   Int           @default(1)
  unitPrice  Float         @default(0)
  tradePrice Float?        @default(0)
  totalPrice Float         @default(0)
  createdAt  DateTime      @default(now())

  @@index([bookingId])
  @@index([itemId])
  @@map("booking_items")
}

// ==========================================
// 6. DYNAMIC INVITATIONS
// ==========================================

model InvitationTemplate {
  id              String       @id @default(uuid())
  title           String
  slug            String       @unique
  category        String       @default("Wedding")
  description     String?      @db.Text
  previewImage    String
  canvasWidth     Int          @default(1080)
  canvasHeight    Int          @default(1920)
  defaultSettings Json?
  fieldsSchema    Json?
  isActive        Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  invitations     Invitation[]

  @@map("invitation_templates")
}

model Invitation {
  id               String              @id @default(uuid())
  shareSlug        String              @unique
  templateId       String?
  template         InvitationTemplate? @relation(fields: [templateId], references: [id])
  customerId       String?
  customer         Customer?           @relation(fields: [customerId], references: [id])
  title            String
  coupleNames      String?
  eventName        String
  eventDate        DateTime?
  eventTime        String?
  venueName        String?
  venueAddress     String?
  contactDetails   String?
  rsvpDeadline     DateTime?
  customMessage    String?             @db.Text
  fontFamily       String?             @default("Playfair Display")
  primaryColor     String?             @default("#0E1B3A")
  secondaryColor   String?             @default("#C8A24B")
  accentColor      String?             @default("#E7C977")
  uploadedAssets   Json?
  customData       Json?
  generatedImageUrl String?
  generatedPdfUrl  String?
  status           String              @default("DRAFT")
  viewsCount       Int                 @default(0)
  rsvpCount        Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([templateId])
  @@index([customerId])
  @@index([shareSlug])
  @@map("invitations")
}

// ==========================================
// 7. AI IMAGE & VIDEO GENERATIONS
// ==========================================

enum AiGenType {
  IMAGE
  VIDEO
}

enum AiGenStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AiGeneration {
  id              String                @id @default(uuid())
  customerId      String?
  customer        Customer?             @relation(fields: [customerId], references: [id])
  generationType  AiGenType             @default(IMAGE)
  status          AiGenStatus           @default(PENDING)
  prompt          String                @db.Text
  negativePrompt  String?               @db.Text
  instructions    String?               @db.Text
  visualTheme     String?
  durationSeconds Int?                  @default(5)
  aspectRatio     String?               @default("16:9")
  provider        String                @default("modular_mock")
  providerModel   String?               @default("fs-luxury-v1")
  rawResponse     Json?
  resultUrl       String?               @db.Text
  thumbnailUrls   Json?
  errorReason     String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  completedAt     DateTime?
  items           AiGenerationItem[]
  history         AiGenerationHistory[]

  @@index([customerId])
  @@index([generationType])
  @@index([status])
  @@map("ai_generations")
}

enum ItemRoleInGen {
  BACKGROUND
  STAGE
  MANDAP
  FLORAL
  LIGHTING
  PROP
  GENERAL
}

model AiGenerationItem {
  id                String        @id @default(uuid())
  generationId      String
  generation        AiGeneration  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id])
  role              ItemRoleInGen @default(GENERAL)
  referenceImageUrl String?
  createdAt         DateTime      @default(now())

  @@index([generationId])
  @@index([itemId])
  @@map("ai_generation_items")
}

model AiGenerationHistory {
  id             String       @id @default(uuid())
  generationId   String
  generation     AiGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  variationIndex Int          @default(1)
  imageUrl       String?      @db.Text
  videoUrl       String?      @db.Text
  promptUsed     String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([generationId])
  @@map("ai_generation_history")
}

// ==========================================
// 8. ZOHO & WHATSAPP INTEGRATIONS
// ==========================================

model ZohoIntegration {
  id                   String    @id @default(uuid())
  environment          String    @default("production")
  clientId             String?
  clientSecret         String?
  refreshToken         String?
  accessToken          String?   @db.Text
  tokenExpiresAt       DateTime?
  apiDomain            String?   @default("https://www.zohoapis.com")
  isEnabled            Boolean   @default(false)
  autoSyncLeads        Boolean   @default(true)
  syncFrequencyMinutes Int       @default(15)
  lastSyncAt           DateTime?
  lastError            String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("zoho_integrations")
}

model WhatsAppIntegration {
  id                    String   @id @default(uuid())
  apiToken              String?  @db.Text
  phoneNumberId         String?
  businessAccountId     String?
  webhookVerifyToken    String?
  isEnabled             Boolean  @default(false)
  autoReplyWelcome      Boolean  @default(true)
  autoSendBookingConfirm Boolean @default(true)
  autoSendInvitationLink Boolean @default(true)
  templatesConfig       Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("whatsapp_integrations")
}

enum CommChannel {
  WHATSAPP
  ZOHO
  EMAIL
}

enum CommDirection {
  INBOUND
  OUTBOUND
}

enum CommStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model CommunicationLog {
  id              String        @id @default(uuid())
  channel         CommChannel   @default(WHATSAPP)
  direction       CommDirection @default(OUTBOUND)
  recipient       String
  referenceType   String?
  referenceId     String?
  inquiryId       String?
  inquiry         Inquiry?      @relation(fields: [inquiryId], references: [id])
  templateName    String?
  messagePayload  Json?
  responsePayload Json?
  status          CommStatus    @default(PENDING)
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([inquiryId])
  @@index([channel])
  @@index([status])
  @@map("communication_logs")
}

// ==========================================
// 9. AUDIT, NOTIFICATIONS & SETTINGS
// ==========================================

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String   @db.Text
  type       String   @default("INQUIRY")
  readStatus Boolean  @default(false)
  actionUrl  String?
  createdAt  DateTime @default(now())

  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@map("activity_logs")
}

model SystemSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique
  settingValue String   @db.Text
  group        String   @default("general")
  description  String?
  isPublic     Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@map("system_settings")
}
